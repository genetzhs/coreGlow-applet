{
    "head": {
        "type": "header",
        "description": "Coreglow Panel — CPU, memory & load"
    },
    "mode": {
        "type": "combobox",
        "default": "cpumem",
        "options": {
            "CPU + memory": "cpumem",
            "Load average": "load",
            "Network": "net",
            "Uptime": "uptime",
            "Public / LAN IP": "ip",
            "Temperature": "temp",
            "Weather": "weather"
        },
        "description": "Monitor"
    },
    "interval": {
        "type": "spinbutton",
        "default": 1,
        "min": 1,
        "max": 30,
        "step": 1,
        "units": "s",
        "description": "Refresh interval"
    },
    "theme": {
        "type": "combobox",
        "default": "auto",
        "options": {
            "Follow Cinnamon": "auto",
            "Dark": "dark",
            "Light": "light"
        },
        "description": "Theme"
    },
    "accent1": {
        "type": "colorchooser",
        "default": "rgb(0,200,255)",
        "description": "CPU accent"
    },
    "accent2": {
        "type": "colorchooser",
        "default": "rgb(150,90,255)",
        "description": "Memory accent"
    },
    "head2": {
        "type": "header",
        "description": "Display"
    },
    "showSpark": {
        "type": "checkbox",
        "default": true,
        "description": "Show 60-second graphs"
    },
    "showLabels": {
        "type": "checkbox",
        "default": true,
        "description": "Show CPU / RAM labels"
    },
    "hoverOpen": {
        "type": "checkbox",
        "default": false,
        "description": "Open the details menu on mouse over"
    },
    "hotAt": {
        "type": "spinbutton",
        "default": 85,
        "min": 50,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Warn threshold (amber / red)"
    },
    "headWx": {
        "type": "header",
        "description": "Weather (MET Norway)"
    },
    "wxPlace": {
        "type": "entry",
        "default": "Πατσίδες",
        "description": "Place name"
    },
    "wxLat": {
        "type": "entry",
        "default": "35.2681",
        "description": "Latitude"
    },
    "wxLon": {
        "type": "entry",
        "default": "25.1818",
        "description": "Longitude"
    },
    "wxMins": {
        "type": "spinbutton",
        "default": 30,
        "min": 10,
        "max": 180,
        "step": 5,
        "units": "min",
        "description": "Refresh every"
    }
}